{
  "name": "rag-assistant",
  "version": "1.0.0",
  "description": "基于 LangChain + TypeScript 的本地 RAG 个人助手",
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./plugin": "./dist/plugin/index.js"
  },
  "types": "dist/index.d.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "cli": "tsx src/cli.ts",
    "test": "vitest",
    "test:unit": "vitest run --dir src/__tests__/unit",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "rag",
    "langchain",
    "ai",
    "chatbot",
    "retrieval"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@langchain/anthropic": "^0.2.0",
    "@langchain/community": "^0.2.0",
    "@langchain/core": "^0.2.0",
    "@langchain/ollama": "^0.1.0",
    "@langchain/openai": "^0.2.0",
    "@langchain/textsplitters": "^0.0.0",
    "@mozilla/readability": "^0.6.0",
    "chromadb": "^1.9.0",
    "cors": "^2.8.5",
    "dotenv": "^16.0.0",
    "express": "^4.18.0",
    "jsdom": "^29.1.1",
    "langchain": "^0.2.0",
    "mammoth": "^1.6.0",
    "marked": "^12.0.0",
    "multer": "^1.4.5-lts.1",
    "pdf-parse": "^1.1.1",
    "pdfjs-dist": "^5.6.205",
    "playwright": "^1.60.0",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.0",
    "@types/express": "^4.17.0",
    "@types/jsdom": "^28.0.3",
    "@types/multer": "^1.4.0",
    "@types/node": "^20.0.0",
    "@types/uuid": "^9.0.0",
    "@vitest/coverage-v8": "^1.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
